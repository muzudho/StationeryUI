{
    "window": {
        "width": 1000,
        "height": 660
    },
    "models": [
        {
            "id": "developerViewport",
            "type": "viewport",
            "children": [
                {
                    "id": "developerWindow",
                    "type": "page",
                    "children": [
                        {
                            "id": "instructions",
                            "type": "textBlock"
                        },
                        {
                            "id": "inspectorSplit",
                            "type": "splitPane",
                            "children": [
                                {
                                    "id": "stationeryTree",
                                    "type": "tree"
                                },
                                {
                                    "id": "details",
                                    "type": "textBlock"
                                }
                            ]
                        },
                        {
                            "id": "copyPath",
                            "type": "button"
                        },
                        {
                            "id": "inspectorPanel",
                            "type": "container",
                            "children": [
                                {
                                    "id": "toolHint",
                                    "type": "textBlock"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "layouts": [
        {
            "id": "windowLayout",
            "type": "grid-layout",
            "row-definitions": [
                "1rate",
                "80px"
            ],
            "column-definitions": [
                "1rate"
            ],
            "children": [
                {
                    "id": "windowRows",
                    "type": "grid-layout",
                    "row-definitions": [
                        "56px",
                        "1rate",
                        "48px"
                    ],
                    "column-definitions": [
                        "1rate"
                    ],
                    "padding": {
                        "top": "8px",
                        "right": "8px",
                        "bottom": "8px",
                        "left": "8px"
                    },
                    "row": 0,
                    "col": 0,
                    "slots": [
                        {
                            "id": "instructions",
                            "row": 0,
                            "col": 0
                        },
                        {
                            "id": "inspectorSplit",
                            "row": 1,
                            "col": 0
                        },
                        {
                            "id": "copyPath",
                            "row": 2,
                            "col": 0
                        }
                    ]
                }
            ],
            "slots": [
                {
                    "id": "inspectorPanel",
                    "row": 1,
                    "col": 0
                }
            ]
        },
        {
            "id": "inspectorContents",
            "type": "grid-layout",
            "row-definitions": [
                "1rate"
            ],
            "column-definitions": [
                "1rate"
            ],
            "padding": {
                "top": "8px",
                "right": "8px",
                "bottom": "8px",
                "left": "8px"
            },
            "slots": [
                {
                    "id": "toolHint",
                    "row": 0,
                    "col": 0
                }
            ]
        },
        {
            "id": "inspectorColumns",
            "type": "split-pane",
            "orientation": "vertical",
            "ratio": 0.4,
            "dividerWidth": "10px",
            "minimumPaneSize": "120px"
        }
    ],
    "bindings": [
        {
            "layout": "/windowLayout",
            "parentModel": "developerViewport/developerWindow",
            "childrenModel": [
                {
                    "model": "inspectorPanel",
                    "slot": "inspectorPanel"
                }
            ]
        },
        {
            "layout": "/inspectorContents",
            "parentModel": "developerViewport/developerWindow/inspectorPanel",
            "childrenModel": [
                {
                    "model": "toolHint",
                    "slot": "toolHint"
                }
            ]
        },
        {
            "layout": "/windowLayout/windowRows",
            "parentModel": "developerViewport/developerWindow",
            "childrenModel": [
                {
                    "model": "instructions",
                    "slot": "instructions"
                },
                {
                    "model": "inspectorSplit",
                    "slot": "inspectorSplit"
                },
                {
                    "model": "copyPath",
                    "slot": "copyPath"
                }
            ]
        },
        {
            "layout": "/inspectorColumns",
            "model": "developerViewport/developerWindow/inspectorSplit",
            "firstModel": "stationeryTree",
            "secondModel": "details"
        }
    ]
}
