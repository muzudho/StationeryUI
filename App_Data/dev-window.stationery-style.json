{
    "window": {
        "width": 1000,
        "height": 660
    },
    "models": [
        {
            "id": "developerViewport",
            "type": "viewport",
            "children": [
                {
                    "id": "developerWindow",
                    "type": "page",
                    "children": [
                        {
                            "id": "instructions",
                            "type": "textBlock"
                        },
                        {
                            "id": "inspectorSplit",
                            "type": "splitPane",
                            "children": [
                                {
                                    "id": "stationeryTree",
                                    "type": "tree"
                                },
                                {
                                    "id": "details",
                                    "type": "textBlock"
                                }
                            ]
                        },
                        {
                            "id": "copyPath",
                            "type": "button"
                        },
                        {
                            "id": "inspectorPanel",
                            "type": "container",
                            "children": [
                                {
                                    "id": "toolHint",
                                    "type": "textBlock"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "layouts": [
        {
            "id": "workPage",
            "type": "work-page-layout",
            "inspectorHeight": "80px"
        },
        {
            "id": "inspectorPadding",
            "type": "box-layout",
            "padding": {
                "top": "8px",
                "right": "8px",
                "bottom": "8px",
                "left": "8px"
            }
        },
        {
            "id": "inspectorContents",
            "type": "grid-layout",
            "row-definitions": [
                "1rate"
            ],
            "column-definitions": [
                "1rate"
            ]
        },
        {
            "id": "windowPadding",
            "type": "box-layout",
            "padding": {
                "top": "8px",
                "right": "8px",
                "bottom": "8px",
                "left": "8px"
            }
        },
        {
            "id": "windowRows",
            "type": "grid-layout",
            "row-definitions": [
                "56px",
                "1rate",
                "48px"
            ],
            "column-definitions": [
                "1rate"
            ]
        },
        {
            "id": "inspectorColumns",
            "type": "split-pane",
            "orientation": "vertical",
            "ratio": 0.4,
            "dividerWidth": "10px",
            "minimumPaneSize": "120px"
        }
    ],
    "bindings": [
        {
            "layout": "workPage",
            "model": "developerViewport/developerWindow",
            "inspectorModel": "inspectorPanel"
        },
        {
            "layout": "inspectorPadding",
            "model": "developerViewport/developerWindow/inspectorPanel"
        },
        {
            "layout": "inspectorContents",
            "parentModel": "developerViewport/developerWindow/inspectorPanel",
            "childrenModel": [
                {
                    "model": "toolHint",
                    "row": 0,
                    "column": 0
                }
            ]
        },
        {
            "layout": "windowPadding",
            "model": "developerViewport/developerWindow"
        },
        {
            "layout": "windowRows",
            "parentModel": "developerViewport/developerWindow",
            "childrenModel": [
                {
                    "model": "instructions",
                    "row": 0,
                    "column": 0
                },
                {
                    "model": "inspectorSplit",
                    "row": 1,
                    "column": 0
                },
                {
                    "model": "copyPath",
                    "row": 2,
                    "column": 0
                }
            ]
        },
        {
            "layout": "inspectorColumns",
            "model": "developerViewport/developerWindow/inspectorSplit",
            "firstModel": "stationeryTree",
            "secondModel": "details"
        }
    ]
}
