{
    "window": {
        "width": 1000,
        "height": 660
    },
    "models": [
        {
            "id": "developerViewport",
            "type": "viewport",
            "children": [
                {
                    "id": "developerWindow",
                    "type": "page",
                    "children": [
                        {
                            "id": "instructions",
                            "type": "textBlock"
                        },
                        {
                            "id": "inspectorSplit",
                            "type": "splitPane",
                            "children": [
                                {
                                    "id": "stationeryTree",
                                    "type": "tree"
                                },
                                {
                                    "id": "details",
                                    "type": "textBlock"
                                }
                            ]
                        },
                        {
                            "id": "copyPath",
                            "type": "button"
                        },
                        {
                            "id": "inspectorPanel",
                            "type": "container",
                            "children": [
                                {
                                    "id": "toolHint",
                                    "type": "textBlock"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "layouts": [
        {
            "id": "viewportRoot",
            "type": "box-layout"
        },
        {
            "id": "windowLayout",
            "type": "grid-layout",
            "row-definitions": [
                "1rate",
                "80px"
            ],
            "column-definitions": [
                "1rate"
            ],
            "children": [
                {
                    "id": "windowRows",
                    "type": "grid-layout",
                    "row-definitions": [
                        "56px",
                        "1rate",
                        "48px"
                    ],
                    "column-definitions": [
                        "1rate"
                    ],
                    "padding": {
                        "top": "8px",
                        "right": "8px",
                        "bottom": "8px",
                        "left": "8px"
                    },
                    "row": 0,
                    "col": 0,
                    "cells": [
                        {
                            "row": 0,
                            "col": 0,
                            "slots": [
                                {
                                    "id": "instructions"
                                }
                            ]
                        },
                        {
                            "row": 1,
                            "col": 0,
                            "slots": [
                                {
                                    "id": "inspectorSplit"
                                }
                            ]
                        },
                        {
                            "row": 2,
                            "col": 0,
                            "slots": [
                                {
                                    "id": "copyPath"
                                }
                            ]
                        }
                    ]
                }
            ],
            "cells": [
                {
                    "row": 1,
                    "col": 0,
                    "slots": [
                        {
                            "id": "inspectorPanel"
                        }
                    ]
                }
            ]
        },
        {
            "id": "inspectorContents",
            "type": "grid-layout",
            "row-definitions": [
                "1rate"
            ],
            "column-definitions": [
                "1rate"
            ],
            "padding": {
                "top": "8px",
                "right": "8px",
                "bottom": "8px",
                "left": "8px"
            },
            "cells": [
                {
                    "row": 0,
                    "col": 0,
                    "slots": [
                        {
                            "id": "toolHint"
                        }
                    ]
                }
            ]
        },
        {
            "id": "inspectorColumns",
            "type": "split-pane",
            "orientation": "vertical",
            "ratio": 0.4,
            "dividerWidth": "10px",
            "minimumPaneSize": "120px"
        }
    ],
    "bindingsV2": {
        "ctrlDeveloperWindow": {
            "layoutPath": "root:viewportRoot/single:windowLayout",
            "modelPath": "/developerViewport/developerWindow"
        },
        "ctrlInstructions": {
            "layoutPath": "root:viewportRoot/single:windowLayout/1y.1x.1w.1h:windowRows/1y.1x.1w.1h",
            "modelPath": "/developerViewport/developerWindow/instructions"
        },
        "ctrlInspectorSplit": {
            "layoutPath": "root:viewportRoot/single:windowLayout/1y.1x.1w.1h:windowRows/2y.1x.1w.1h:inspectorColumns",
            "modelPath": "/developerViewport/developerWindow/inspectorSplit"
        },
        "ctrlStationeryTree": {
            "layoutPath": "root:viewportRoot/single:windowLayout/1y.1x.1w.1h:windowRows/2y.1x.1w.1h:inspectorColumns/first",
            "modelPath": "/developerViewport/developerWindow/inspectorSplit/stationeryTree"
        },
        "ctrlDetails": {
            "layoutPath": "root:viewportRoot/single:windowLayout/1y.1x.1w.1h:windowRows/2y.1x.1w.1h:inspectorColumns/second",
            "modelPath": "/developerViewport/developerWindow/inspectorSplit/details"
        },
        "ctrlCopyPath": {
            "layoutPath": "root:viewportRoot/single:windowLayout/1y.1x.1w.1h:windowRows/3y.1x.1w.1h",
            "modelPath": "/developerViewport/developerWindow/copyPath"
        },
        "ctrlInspectorPanel": {
            "layoutPath": "root:viewportRoot/single:windowLayout/2y.1x.1w.1h:inspectorContents",
            "modelPath": "/developerViewport/developerWindow/inspectorPanel"
        },
        "ctrlToolHint": {
            "layoutPath": "root:viewportRoot/single:windowLayout/2y.1x.1w.1h:inspectorContents/1y.1x.1w.1h",
            "modelPath": "/developerViewport/developerWindow/inspectorPanel/toolHint"
        }
    }
}
