{
    "controlTree": {
        "ctrlDeveloperWindow": {
            "layoutPath": {
                "in /ctrlViewPort": "viewportRoot[single].windowLayout"
            },
            "modelPath": {
                "in /ctrlViewPort": "/developerViewport/developerWindow"
            }
        },
        "ctrlInstructions": {
            "layoutPath": {
                "in /ctrlViewPort/ctrlDeveloperWindow": "viewportRoot[single].windowLayout[1y_1x_1w_1h].windowRows[1y_1x_1w_1h]"
            },
            "modelPath": {
                "in /ctrlViewPort/ctrlDeveloperWindow": "/developerViewport/developerWindow/instructions"
            }
        },
        "ctrlInspectorSplit": {
            "layoutPath": {
                "in /ctrlViewPort/ctrlDeveloperWindow": "viewportRoot[single].windowLayout[1y_1x_1w_1h].windowRows[2y_1x_1w_1h].inspectorColumns"
            },
            "modelPath": {
                "in /ctrlViewPort/ctrlDeveloperWindow": "/developerViewport/developerWindow/inspectorSplit"
            }
        },
        "ctrlStationeryTree": {
            "layoutPath": {
                "in /ctrlViewPort/ctrlDeveloperWindow/ctrlInspectorSplit": "viewportRoot[single].windowLayout[1y_1x_1w_1h].windowRows[2y_1x_1w_1h].inspectorColumns.first"
            },
            "modelPath": {
                "in /ctrlViewPort/ctrlDeveloperWindow/ctrlInspectorSplit": "/developerViewport/developerWindow/inspectorSplit/stationeryTree"
            }
        },
        "ctrlDetails": {
            "layoutPath": {
                "in /ctrlViewPort/ctrlDeveloperWindow/ctrlInspectorSplit": "viewportRoot[single].windowLayout[1y_1x_1w_1h].windowRows[2y_1x_1w_1h].inspectorColumns.second"
            },
            "modelPath": {
                "in /ctrlViewPort/ctrlDeveloperWindow/ctrlInspectorSplit": "/developerViewport/developerWindow/inspectorSplit/details"
            }
        },
        "ctrlCopyPath": {
            "layoutPath": {
                "in /ctrlViewPort/ctrlDeveloperWindow": "viewportRoot[single].windowLayout[1y_1x_1w_1h].windowRows[3y_1x_1w_1h]"
            },
            "modelPath": {
                "in /ctrlViewPort/ctrlDeveloperWindow": "/developerViewport/developerWindow/copyPath"
            }
        },
        "ctrlInspectorPanel": {
            "layoutPath": {
                "in /ctrlViewPort/ctrlDeveloperWindow": "viewportRoot[single].windowLayout[2y_1x_1w_1h].inspectorContents"
            },
            "modelPath": {
                "in /ctrlViewPort/ctrlDeveloperWindow": "/developerViewport/developerWindow/inspectorPanel"
            }
        },
        "ctrlToolHint": {
            "layoutPath": {
                "in /ctrlViewPort/ctrlDeveloperWindow/ctrlInspectorPanel": "viewportRoot[single].windowLayout[2y_1x_1w_1h].inspectorContents[1y_1x_1w_1h]"
            },
            "modelPath": {
                "in /ctrlViewPort/ctrlDeveloperWindow/ctrlInspectorPanel": "/developerViewport/developerWindow/inspectorPanel/toolHint"
            }
        }
    },
    "modelTree": {
        "id": "developerViewport",
        "type": "viewport",
        "children": [
            {
                "id": "developerWindow",
                "type": "page",
                "children": [
                    {
                        "id": "instructions",
                        "type": "textBlock"
                    },
                    {
                        "id": "inspectorSplit",
                        "type": "splitPane",
                        "children": [
                            {
                                "id": "stationeryTree",
                                "type": "tree"
                            },
                            {
                                "id": "details",
                                "type": "textBlock"
                            }
                        ]
                    },
                    {
                        "id": "copyPath",
                        "type": "button"
                    },
                    {
                        "id": "inspectorPanel",
                        "type": "container",
                        "children": [
                            {
                                "id": "toolHint",
                                "type": "textBlock"
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "window": {
        "width": 1000,
        "height": 660
    },
    "layouts": [
        {
            "id": "viewportRoot",
            "type": "box-layout"
        },
        {
            "id": "windowLayout",
            "type": "grid-layout",
            "row-definitions": [
                "1rate",
                "80px"
            ],
            "column-definitions": [
                "1rate"
            ],
            "children": [
                {
                    "id": "windowRows",
                    "type": "grid-layout",
                    "row-definitions": [
                        "56px",
                        "1rate",
                        "48px"
                    ],
                    "column-definitions": [
                        "1rate"
                    ],
                    "padding": {
                        "top": "8px",
                        "right": "8px",
                        "bottom": "8px",
                        "left": "8px"
                    },
                    "row": 0,
                    "col": 0,
                    "cells": [
                        {
                            "row": 0,
                            "col": 0,
                            "slots": [
                                {
                                    "id": "instructions"
                                }
                            ]
                        },
                        {
                            "row": 1,
                            "col": 0,
                            "slots": [
                                {
                                    "id": "inspectorSplit"
                                }
                            ]
                        },
                        {
                            "row": 2,
                            "col": 0,
                            "slots": [
                                {
                                    "id": "copyPath"
                                }
                            ]
                        }
                    ]
                }
            ],
            "cells": [
                {
                    "row": 1,
                    "col": 0,
                    "slots": [
                        {
                            "id": "inspectorPanel"
                        }
                    ]
                }
            ]
        },
        {
            "id": "inspectorContents",
            "type": "grid-layout",
            "row-definitions": [
                "1rate"
            ],
            "column-definitions": [
                "1rate"
            ],
            "padding": {
                "top": "8px",
                "right": "8px",
                "bottom": "8px",
                "left": "8px"
            },
            "cells": [
                {
                    "row": 0,
                    "col": 0,
                    "slots": [
                        {
                            "id": "toolHint"
                        }
                    ]
                }
            ]
        },
        {
            "id": "inspectorColumns",
            "type": "split-pane",
            "orientation": "vertical",
            "ratio": 0.4,
            "dividerWidth": "10px",
            "minimumPaneSize": "120px"
        }
    ]
}
