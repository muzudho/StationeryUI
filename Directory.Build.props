<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>0.5.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <Authors>むずでょ</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/muzudho/StationeryUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Stationery-inspired desktop GUI controls and Japanese text input for MonoGame.</Description>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)docs/ai-agents/get-started/nuget-agent-guide.md" Pack="true" PackagePath="docs/dev/" />
    <None Include="$(MSBuildThisFileDirectory)docs/ai-agents/get-started/library-integration.md" Pack="true" PackagePath="docs/dev/" />
    <None Include="$(MSBuildThisFileDirectory)docs/dev/products/developer-window/README.md" Pack="true" PackagePath="docs/dev/developer-window.md" />
    <None Include="$(MSBuildThisFileDirectory)docs/dev/products/developer-window/layout-inspector/README.md" Pack="true" PackagePath="docs/dev/model-inspection.md" />
    <None Include="$(MSBuildThisFileDirectory)docs/dev/structure/style-settings-file/layouts/dock-layout.md" Pack="true" PackagePath="docs/dev/" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)docs/user/CircleSpaceCoordinator-LICENSE.txt" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
</Project>
